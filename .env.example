NODE_ENV=development
DEPLOYMENT_ENV=development
PORT=3004
APP_ORIGIN=http://127.0.0.1:5173
DATA_DIR=./data/azuriya
# Production requires a PostgreSQL server and HTTPS origin.
# DATABASE_URL=postgresql://azuriya_runtime:password@localhost:5432/azuriya
# MIGRATION_DATABASE_URL=postgresql://azuriya_owner:password@localhost:5432/azuriya
CORE_BOOTSTRAP_EMAIL=admin@azuriya.local
# Supply a strong password of at least 12 characters before npm run bootstrap.
CORE_BOOTSTRAP_PASSWORD=
# Supply a base64 32-byte key to use the credential encryption abstraction.
SECRET_ENCRYPTION_KEY=
# Leave unset until a real edge routing target is available.
DOMAIN_CNAME_TARGET=
# Staging and production require verified PostgreSQL TLS. Omit custom CA only for a publicly trusted CA.
DB_TLS_CA_FILE=
# Comma-separated ingress IPs/CIDRs that may supply forwarded HTTPS/host/client-address headers.
TRUSTED_PROXY_IPS=
# Operator-managed authenticated HTTPS certificate + edge bridge. Private certificate keys stay at the provider.
DOMAIN_PROVIDER_URL=
DOMAIN_PROVIDER_TOKEN=
# Resend email adapter; the email worker retries while these are unavailable.
EMAIL_API_KEY=
EMAIL_FROM=
# Backup task secrets belong to a separate scheduler environment, never the web process.
BACKUP_DATABASE_URL=
RESTORE_DATABASE_URL=
BACKUP_ENCRYPTION_KEY=
PG_BIN=
