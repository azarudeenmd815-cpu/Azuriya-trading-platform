# Local development only. Copy to .env and replace both password placeholders.
POSTGRES_USER=azuriya
POSTGRES_DB=azuriya
POSTGRES_PASSWORD=replace-local-postgres-password
DATABASE_URL=postgres://azuriya:replace-local-postgres-password@localhost:5432/azuriya?sslmode=disable
REDIS_URL=redis://localhost:6379/0
STORAGE_MODE=postgres
PORT=8080
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SEED_DEMO=true
DEMO_EMAIL=demo@azuriya.local
DEMO_PASSWORD=replace-local-demo-password
FEED_INTERVAL_MS=1000
FEED_SEED=42
EXECUTION_LATENCY_MS=0
NEXT_PUBLIC_API_URL=http://localhost:8080
FEED_SPREAD_TICKS=0

# Public website SEO. Leave these defaults for local development and previews.
# Set SITE_URL to the confirmed HTTPS origin in the web app's deployment env.
# Enable indexing only on the production deployment after reviewing public content.
SITE_URL=
SEO_ALLOW_INDEXING=false
# Optional HTML verification tokens; DNS verification can be used instead.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
